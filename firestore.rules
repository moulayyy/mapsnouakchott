rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Admin = propriétaire : marqueur créé uniquement depuis la console Firebase.
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Employé actif créé par l'admin.
    function isStaff() {
      return signedIn() &&
        exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true;
    }
    // Admin, ou employé actif ayant l'autorisation p.
    function can(p) {
      return isAdmin() || (isStaff() &&
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.permissions.hasAny([p]));
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Fiches employés : gérées par l'admin, lisibles par leur titulaire.
    match /staff/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'phone', 'createdAt']);
    }

    // Index (moughataas, lotissements, plans, blocs)
    match /meta/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Parcelles et îlots estimés (sans valeur juridique) : lecture pour tout compte connecté.
    match /est_lots/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /est_blocks/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Géométrie visible par les clients : uniquement les lots actifs.
    match /geo_public/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    // Géométrie complète (lots désactivés inclus) : admin seulement.
    match /geo_all/{doc} {
      allow read, write: if isAdmin();
    }

    // Détails d'un lot (prix, photos, actif). Un lot désactivé est invisible aux clients.
    match /lots/{key} {
      allow get: if signedIn() && (resource == null || resource.data.active != false || isAdmin());
      allow list: if isAdmin() || (signedIn() && resource.data.active == true);
      allow write: if isAdmin();
    }

    // Propriétaire et notes privées : admin seulement.
    match /lots_private/{key} {
      allow read, write: if isAdmin();
    }

    // Chat : un client ne voit que sa conversation ; l'équipe autorisée voit tout.
    match /chats/{uid} {
      allow read, write: if signedIn() && (request.auth.uid == uid || can('chat'));
      match /messages/{id} {
        allow read: if signedIn() && (request.auth.uid == uid || can('chat'));
        allow create: if signedIn() && (
          (request.auth.uid == uid && request.resource.data.from == 'client') ||
          (can('chat') && request.resource.data.from == 'admin'));
        allow update, delete: if false;
      }
    }

    // Demandes de terrain : le client voit les siennes ; l'équipe autorisée voit tout.
    match /requests/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'ouverte'
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'phone', 'moughataa', 'lotissement', 'lot',
          'areaMin', 'areaMax', 'budgetMin', 'budgetMax', 'offer', 'construction',
          'message', 'status', 'createdAt', 'lastAt', 'lastMessage',
          'unreadStaff', 'unreadClient']);
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || can('demandes'));
      allow update: if signedIn() && (
        (resource.data.uid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastAt', 'lastMessage', 'unreadStaff', 'unreadClient'])) ||
        (can('demandes') &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastAt', 'lastMessage', 'unreadStaff', 'unreadClient', 'status'])));
      allow delete: if false;

      match /replies/{rid} {
        allow read: if signedIn() && (
          get(/databases/$(database)/documents/requests/$(id)).data.uid == request.auth.uid
          || can('demandes'));
        allow create: if signedIn() && (
          (get(/databases/$(database)/documents/requests/$(id)).data.uid == request.auth.uid
            && request.resource.data.from == 'client') ||
          (can('demandes') && request.resource.data.from == 'staff'));
        allow update, delete: if false;
      }
    }
  }
}
